{
  "name": "cf-comments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight self-hosted comment system on Cloudflare Workers and D1",
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:worker": "node --experimental-strip-types --test tests/worker/*.test.ts",
    "test": "pnpm run test:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "build": "pnpm run build:worker",
    "import:waline": "node --experimental-strip-types scripts/import-waline.ts",
    "dev": "cf dev --local",
    "deploy:staging": "cf deploy --prebuilt --mode staging",
    "deploy": "cf deploy --prebuilt"
  },
  "dependencies": {
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cloudflare/build-output-utils": "0.8.0",
    "@cloudflare/config": "0.18.0",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
