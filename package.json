{
  "name": "cf-comments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight self-hosted comment system on Cloudflare Workers and D1",
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --project tsconfig.browser.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:worker": "node --experimental-strip-types --test tests/worker/*.test.ts",
    "test:client": "node --experimental-strip-types --test --test-isolation=none tests/client/*.test.ts",
    "test": "pnpm run test:worker && pnpm run test:client",
    "build:static": "node scripts/build-static.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "build": "pnpm run build:static && pnpm run build:worker",
    "import:waline": "node --experimental-strip-types scripts/import-waline.ts",
    "backfill:waline-avatars": "node --experimental-strip-types scripts/backfill-waline-avatars.ts",
    "dev": "cf dev --local",
    "deploy:staging": "cf deploy --prebuilt --mode staging",
    "deploy": "cf deploy --prebuilt"
  },
  "dependencies": {
    "mfm-js": "^0.28.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cloudflare/build-output-utils": "0.8.0",
    "@cloudflare/config": "0.18.0",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@iconify-json/simple-icons": "^1.2.100",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
