{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comments.example.com/schemas/export-v1.schema.json",
  "title": "cf-comments Standard Export Format v1",
  "description": "Portable canonical JSON format for admin backups and cross-system comment migrations. Default exports (include_private=false) omit visitor emails but still include non-public moderation statuses and are NOT public-safe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "exported_at",
    "include_private",
    "comments"
  ],
  "properties": {
    "format": {
      "const": "cf-comments",
      "description": "Format identifier."
    },
    "version": {
      "const": 1,
      "description": "Schema major version."
    },
    "exported_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp when the export was generated."
    },
    "site": {
      "type": "string",
      "format": "uri",
      "description": "Optional origin site URL (e.g. https://blog.example.com)."
    },
    "include_private": {
      "type": "boolean",
      "description": "False for email-omitted admin backups (author_email forbidden). True for explicit private backups/migrations including author_email."
    },
    "path_aliases": {
      "type": "array",
      "description": "Optional explicit path alias mappings.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias_path", "canonical_path"],
        "properties": {
          "alias_path": {
            "type": "string",
            "pattern": "^/(?:[^/?#]+/)*$"
          },
          "canonical_path": {
            "type": "string",
            "pattern": "^/(?:[^/?#]+/)*$"
          }
        }
      }
    },
    "comments": {
      "type": "array",
      "description": "Flat list of comments. Parent links use direct parent_id; root_id is derived by the importer.",
      "items": {
        "$ref": "#/$defs/ExportComment"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "include_private": { "const": false }
        },
        "required": ["include_private"]
      },
      "then": {
        "properties": {
          "comments": {
            "items": {
              "not": {
                "required": ["author_email"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ExportComment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "parent_id",
        "status",
        "is_admin",
        "content_markdown",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,64}$",
          "description": "Stable unique comment identifier."
        },
        "path": {
          "type": "string",
          "pattern": "^/(?:[^/?#]+/)*$",
          "description": "Canonical normalized site path with leading and trailing slash (no consecutive slashes)."
        },
        "parent_id": {
          "type": ["string", "null"],
          "pattern": "^[a-zA-Z0-9_-]{8,64}$",
          "description": "Direct parent comment ID, or null for root comments."
        },
        "status": {
          "type": "string",
          "enum": ["approved", "pending", "hidden", "spam", "deleted"],
          "description": "Moderation status."
        },
        "syntax": {
          "type": "string",
          "enum": ["gfm", "mfm"],
          "default": "gfm",
          "description": "Explicit per-comment markup syntax (defaults to gfm when omitted in legacy imports)."
        },
        "author_name": {
          "type": ["string", "null"],
          "maxLength": 80,
          "description": "Display name, or null for anonymous/deleted comments."
        },
        "author_url": {
          "type": ["string", "null"],
          "format": "uri",
          "maxLength": 512,
          "description": "Optional http(s) author website URL."
        },
        "author_email": {
          "type": ["string", "null"],
          "format": "email",
          "maxLength": 254,
          "description": "Allowed only when include_private is true. Imported emails are NEVER auto-subscribed to notifications."
        },
        "is_admin": {
          "type": "boolean",
          "description": "Whether the comment was authored by a verified site administrator."
        },
        "content_markdown": {
          "type": ["string", "null"],
          "maxLength": 10000,
          "description": "Raw Markdown source text (non-empty string unless status is deleted, in which case null)."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Original creation time in UTC ISO-8601."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification time in UTC ISO-8601."
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional provenance metadata for idempotent migrations.",
          "required": ["system", "external_id"],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "external_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "deleted" }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "content_markdown": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "content_markdown": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            }
          }
        }
      ]
    }
  }
}
