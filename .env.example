# ==============================================================================
# cf-comments Environment & Secrets Example
# Copy to .dev.vars for local development (never commit real secrets).
# For staging/production, upload secrets via `cf deploy --secrets-file` or Secrets API.
# ==============================================================================

# --- Required Secrets ---
ADMIN_TOKEN=replace-with-strong-random-admin-token
TOKEN_SIGNING_SECRET=replace-with-strong-random-hmac-secret

# --- Optional Turnstile Secret (paired with TURNSTILE_SITE_KEY in cloudflare.config.ts) ---
TURNSTILE_SECRET_KEY=

# --- Optional Email Secrets (depends on ADMIN_EMAIL_PROVIDER / REPLY_EMAIL_PROVIDER) ---
RESEND_API_KEY=
EMAIL_HTTP_TOKEN=

# --- Optional Build-time Config Overrides (evaluated when building cloudflare.config.ts) ---
CF_D1_DATABASE_ID=
CF_D1_STAGING_DATABASE_ID=
CF_SITE_URL=https://blog.chiyo.uk
CF_ALLOWED_ORIGINS=https://blog.chiyo.uk
CF_COMMENTS_DOMAIN=comments.chiyo.uk
CF_STAGING_DOMAIN=
CF_ADMIN_NOTIFY_EMAIL=
CF_EMAIL_FROM=comments@chiyo.uk
CF_EMAIL_HTTP_ENDPOINT=
CF_ADMIN_EMAIL_PROVIDER=none
CF_REPLY_EMAIL_PROVIDER=none
CF_MODERATION_MODE=pre
CF_TURNSTILE_SITE_KEY=
