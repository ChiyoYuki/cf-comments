# ==============================================================================
# cf-comments Secrets & Optional Env Overrides Example
# 1. Copy cf-comments.config.example.json -> cf-comments.config.json for site settings.
# 2. Copy this file -> .dev.vars for local secrets (never commit real secrets).
# 3. For staging/production, upload secrets via `cf deploy --secrets-file`.
# ==============================================================================

# --- Required Secrets ---
ADMIN_TOKEN=replace-with-strong-random-admin-token
TOKEN_SIGNING_SECRET=replace-with-strong-random-hmac-secret

# --- Optional Secrets ---
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_HTTP_TOKEN=

# --- Optional Build-time Env Overrides (override cf-comments.config.json in CI) ---
CF_COMMENTS_CONFIG=
CF_D1_DATABASE_ID=
CF_D1_STAGING_DATABASE_ID=
CF_SITE_URL=https://blog.example.com
CF_ALLOWED_ORIGINS=https://blog.example.com
CF_COMMENTS_DOMAIN=comments.example.com
CF_STAGING_DOMAIN=
CF_MISSKEY_INSTANCE_URL=https://misskey.io
CF_ADMIN_NOTIFY_EMAIL=
CF_EMAIL_FROM=comments@example.com
CF_EMAIL_HTTP_ENDPOINT=
CF_ADMIN_EMAIL_PROVIDER=none
CF_REPLY_EMAIL_PROVIDER=none
CF_MODERATION_MODE=pre
CF_GRAVATAR_ENABLED=false
CF_TURNSTILE_SITE_KEY=
